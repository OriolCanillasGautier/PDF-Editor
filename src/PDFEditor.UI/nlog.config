<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Info"
      internalLogFile="${specialfolder:folder=LocalApplicationData}/PDFEditor/logs/nlog-internal.log">

  <targets>
    <!-- File target: detailed logs -->
    <target xsi:type="File" 
            name="fileTarget" 
            fileName="${specialfolder:folder=LocalApplicationData}/PDFEditor/logs/pdfeditor-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | ${logger:shortName=true} | ${message} ${exception:format=tostring}"
            archiveEvery="Day"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- Console / Debug target -->
    <target xsi:type="Console" 
            name="consoleTarget" 
            layout="${time} | ${level:uppercase=true:padding=-5} | ${message}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="fileTarget" />
    <logger name="*" minlevel="Info" writeTo="consoleTarget" />
  </rules>
</nlog>
