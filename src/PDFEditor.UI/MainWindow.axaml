    <DockPanel>
        <!-- Status Bar (Bottom) -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="10,3">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding ActiveTab.StatusText, FallbackValue='Ready'}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveTab.SelectionInfoText, FallbackValue=''}"
                           FontSize="11" VerticalAlignment="Center" Opacity="0.6"
                           Margin="0,0,12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding ActiveTab.PageInfoText, FallbackValue=''}"
                               FontSize="11" VerticalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="{Binding ActiveTab.ZoomPercent, FallbackValue=''}"
                               FontSize="11" VerticalAlignment="Center" Opacity="0.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menu Bar (clean, standard) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="OnOpenClick" />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClick" />
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClick" />
                <Separator />
                <MenuItem Header="_Recent Files" Name="RecentFilesMenu">
                    <MenuItem Header="(no recent files)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xport">
                    <MenuItem Header="Export _Dialog..." Click="OnExportDialogClick" />
                    <Separator />
                    <MenuItem Header="Pages to _Images..." Click="OnExportImagesClick" />
                    <MenuItem Header="All _Text..." Click="OnExportTextClick" />
                    <MenuItem Header="To _HTML..." Click="OnExportHtmlClick" />
                    <MenuItem Header="To _Word (DOCX)..." Click="OnExportDocxClick" />
                </MenuItem>
                <MenuItem Header="_Print..." InputGesture="Ctrl+P" Click="OnPrintClick" />
                <Separator />
                <MenuItem Header="_Close Tab" InputGesture="Ctrl+W" Click="OnCloseTabClick" />
                <MenuItem Header="E_xit" InputGesture="Alt+F4" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClick" />
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedoClick" />
                <MenuItem Header="Undo _History..." Click="OnUndoHistoryClick" />
                <Separator />
                <MenuItem Header="Select _All Pages" InputGesture="Ctrl+A" Click="OnSelectAllClick" />
                <Separator />
                <MenuItem Header="_Delete Page(s)" Click="OnContextDeleteClick" />
                <MenuItem Header="Rotate _Right 90°" Click="OnContextRotateRightClick" />
                <MenuItem Header="Rotate _Left 90°" Click="OnContextRotateLeftClick" />
                <Separator />
                <MenuItem Header="Move Page _Up" Click="OnContextMoveUpClick" />
                <MenuItem Header="Move Page _Down" Click="OnContextMoveDownClick" />
                <Separator />
                <MenuItem Header="_Crop Page..." Click="OnCropPageClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Click="OnContextZoomInClick" />
                <MenuItem Header="Zoom _Out" Click="OnContextZoomOutClick" />
                <MenuItem Header="Zoom _Fit" Click="OnContextZoomFitClick" />
                <Separator />
                <MenuItem Header="_First Page" Click="OnFirstPageClick" />
                <MenuItem Header="_Last Page" Click="OnLastPageClick" />
                <Separator />
                <MenuItem Header="Toggle _Dark Theme" Click="OnToggleThemeClick" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Find..." InputGesture="Ctrl+F" Click="OnSearchClick" />
                <MenuItem Header="_Go to Page..." InputGesture="Ctrl+G" Click="OnGoToPageClick" />
                <Separator />
                <MenuItem Header="_Merge Documents..." Click="OnMergeClick" />
                <MenuItem Header="_Split Document..." Click="OnSplitClick" />
                <MenuItem Header="E_xtract Pages..." Click="OnExtractPagesClick" />
                <MenuItem Header="Extract _Text" Click="OnExtractTextViewClick" />
                <Separator />
                <MenuItem Header="_Watermark..." Click="OnWatermarkClick" />
                <MenuItem Header="Page _Numbers..." Click="OnPageNumbersClick" />
                <MenuItem Header="P_assword Protect..." Click="OnPasswordProtectClick" />
                <Separator />
                <MenuItem Header="_Batch Processing..." Click="OnBatchProcessingClick" />
                <Separator />
                <MenuItem Header="_OCR Current Page..." Click="OnOcrCurrentPageClick" />
                <MenuItem Header="OCR _All Pages..." Click="OnOcrAllPagesClick" />
                <MenuItem Header="Make _Searchable PDF (OCR)..." Click="OnMakeSearchablePdfClick" />
                <Separator />
                <MenuItem Header="_Form Fields">
                    <MenuItem Header="_Detect Form Fields" Click="OnDetectFormFieldsClick" />
                    <MenuItem Header="_Fill Form..." Click="OnFillFormClick" />
                    <MenuItem Header="F_latten Form" Click="OnFlattenFormClick" />
                    <Separator />
                    <MenuItem Header="_Export Form Data..." Click="OnExportFormDataClick" />
                    <MenuItem Header="_Import Form Data..." Click="OnImportFormDataClick" />
                    <Separator />
                    <MenuItem Header="_Add Text Field" Click="OnAddTextFieldClick" />
                    <MenuItem Header="Add _Checkbox" Click="OnAddCheckboxFieldClick" />
                    <MenuItem Header="Add _Dropdown" Click="OnAddDropdownFieldClick" />
                </MenuItem>
                <MenuItem Header="Digital _Signatures">
                    <MenuItem Header="_Sign Document..." Click="OnSignDocumentClick" />
                    <MenuItem Header="_Verify Signatures" Click="OnVerifySignaturesClick" />
                    <MenuItem Header="List Si_gnatures" Click="OnListSignaturesClick" />
                    <Separator />
                    <MenuItem Header="_Add Signature Field" Click="OnAddSignatureFieldClick" />
                    <Separator />
                    <MenuItem Header="_Certificate Manager..." Click="OnCertificateManagerClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Redaction">
                    <MenuItem Header="Redact _Text..." Click="OnRedactTextClick" />
                    <MenuItem Header="Redact Current _Page" Click="OnRedactPageClick" />
                    <MenuItem Header="Find Redaction _Targets..." Click="OnFindRedactionTargetsClick" />
                </MenuItem>
                <MenuItem Header="_Compare Documents..." Click="OnCompareDocumentsClick" />
                <Separator />
                <MenuItem Header="_Security">
                    <MenuItem Header="_Encrypt / Set Permissions..." Click="OnPermissionManagerClick" />
                    <MenuItem Header="_Decrypt Document..." Click="OnDecryptDocumentClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Export Annotation Re_port..." Click="OnExportAnnotationReportClick" />
            </MenuItem>
            <MenuItem Header="_Annotate">
                <MenuItem Header="Toggle Annotation _Mode" Click="OnToggleAnnotationMode" />
                <Separator />
                <MenuItem Header="_Text" Click="OnAnnotToolText" />
                <MenuItem Header="_Highlight" Click="OnAnnotToolHighlight" />
                <MenuItem Header="_Rectangle" Click="OnAnnotToolRectangle" />
                <MenuItem Header="_Ellipse" Click="OnAnnotToolEllipse" />
                <MenuItem Header="_Arrow" Click="OnAnnotToolArrow" />
                <MenuItem Header="_Freehand Draw" Click="OnAnnotToolFreehand" />
                <MenuItem Header="Add _Image..." Click="OnAnnotToolImage" />
                <Separator />
                <MenuItem Header="_Blur Region" Click="OnAnnotToolBlur" />
                <MenuItem Header="R_edact Region" Click="OnAnnotToolRedact" />
                <Separator />
                <MenuItem Header="_Underline" Click="OnAnnotToolUnderline" />
                <MenuItem Header="Stri_kethrough" Click="OnAnnotToolStrikethrough" />
                <MenuItem Header="S_ticky Note" Click="OnAnnotToolStickyNote" />
                <MenuItem Header="Stam_p">
                    <MenuItem Header="Approved" Click="OnStampApproved" />
                    <MenuItem Header="Rejected" Click="OnStampRejected" />
                    <MenuItem Header="Confidential" Click="OnStampConfidential" />
                    <MenuItem Header="Draft" Click="OnStampDraft" />
                    <MenuItem Header="Final" Click="OnStampFinal" />
                    <MenuItem Header="For Review" Click="OnStampForReview" />
                    <MenuItem Header="Custom..." Click="OnStampCustom" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Burn Annotations into PDF" Click="OnBurnAnnotations" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
                <MenuItem Header="_Keyboard Shortcuts" Click="OnShortcutsClick" />
            </MenuItem>
        </Menu>

        <!-- ═══ Main Toolbar ═══ -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="1">
                <!-- File group -->
                <Button Classes="tb" Click="OnOpenClick" ToolTip.Tip="Open (Ctrl+O)"><Path Data="{StaticResource IconOpen}" /></Button>
                <Button Classes="tb" Click="OnSaveClick" ToolTip.Tip="Save (Ctrl+S)"><Path Data="{StaticResource IconSave}" /></Button>
                <Button Classes="tb" Click="OnPrintClick" ToolTip.Tip="Print (Ctrl+P)"><Path Data="{StaticResource IconPrint}" /></Button>
                <Border Classes="tb-sep" />

                <!-- Undo/Redo -->
                <Button Classes="tb" Click="OnUndoClick" ToolTip.Tip="Undo (Ctrl+Z)"><Path Data="{StaticResource IconUndo}" /></Button>
                <Button Classes="tb" Click="OnRedoClick" ToolTip.Tip="Redo (Ctrl+Y)"><Path Data="{StaticResource IconRedo}" /></Button>
                <Border Classes="tb-sep" />

                <!-- Page operations -->
                <Button Classes="tb" Click="OnContextDeleteClick" ToolTip.Tip="Delete Page(s)"><Path Data="{StaticResource IconDelete}" /></Button>
                <Button Classes="tb" Click="OnContextRotateRightClick" ToolTip.Tip="Rotate Right"><Path Data="{StaticResource IconRotateRight}" /></Button>
                <Button Classes="tb" Click="OnContextRotateLeftClick" ToolTip.Tip="Rotate Left"><Path Data="{StaticResource IconRotateLeft}" /></Button>
                <Button Classes="tb" Click="OnContextMoveUpClick" ToolTip.Tip="Move Up"><Path Data="{StaticResource IconMoveUp}" /></Button>
                <Button Classes="tb" Click="OnContextMoveDownClick" ToolTip.Tip="Move Down"><Path Data="{StaticResource IconMoveDown}" /></Button>
                <Border Classes="tb-sep" />

                <!-- Document tools -->
                <Button Classes="tb" Click="OnMergeClick" ToolTip.Tip="Merge Documents"><Path Data="{StaticResource IconMerge}" /></Button>
                <Button Classes="tb" Click="OnSplitClick" ToolTip.Tip="Split Document"><Path Data="{StaticResource IconSplit}" /></Button>
                <Button Classes="tb" Click="OnCropPageClick" ToolTip.Tip="Crop Page"><Path Data="{StaticResource IconCrop}" /></Button>
                <Button Classes="tb" Click="OnSearchClick" ToolTip.Tip="Find (Ctrl+F)"><Path Data="{StaticResource IconSearch}" /></Button>
                <Border Classes="tb-sep" />

                <!-- Zoom -->
                <Button Classes="tb" Click="OnContextZoomOutClick" ToolTip.Tip="Zoom Out"><Path Data="{StaticResource IconZoomOut}" /></Button>
                <TextBlock Text="{Binding ActiveTab.ZoomPercent, FallbackValue='100%'}"
                           VerticalAlignment="Center" Width="42"
                           TextAlignment="Center" FontSize="11" Opacity="0.7" />
                <Button Classes="tb" Click="OnContextZoomInClick" ToolTip.Tip="Zoom In"><Path Data="{StaticResource IconZoomIn}" /></Button>
                <Button Classes="tb" Click="OnContextZoomFitClick" ToolTip.Tip="Zoom to Fit"><Path Data="{StaticResource IconFitScreen}" /></Button>
            </StackPanel>
        </Border>

        <!-- ═══ Annotation / Formatting Toolbar (second row) ═══ -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="4,2"
                Name="AnnotationToolbar">
            <StackPanel Orientation="Horizontal" Spacing="1">
                <TextBlock Classes="tb-label" Text="ANNOTATE" />
                <Button Name="BtnAnnotMode" Classes="tb" Click="OnToggleAnnotationMode"
                        ToolTip.Tip="Toggle Annotation Mode">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="{StaticResource IconEdit}" />
                        <TextBlock Text="Edit" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Border Classes="tb-sep" />

                <!-- Drawing tools -->
                <TextBlock Classes="tb-label" Text="TOOLS" />
                <Button Name="BtnToolText" Classes="tb" Click="OnAnnotToolText" ToolTip.Tip="Text (click on page)"><Path Data="{StaticResource IconText}" /></Button>
                <Button Name="BtnToolHighlight" Classes="tb" Click="OnAnnotToolHighlight" ToolTip.Tip="Highlight"><Path Data="{StaticResource IconHighlight}" /></Button>
                <Button Name="BtnToolRect" Classes="tb" Click="OnAnnotToolRectangle" ToolTip.Tip="Rectangle"><Path Data="{StaticResource IconRect}" /></Button>
                <Button Name="BtnToolEllipse" Classes="tb" Click="OnAnnotToolEllipse" ToolTip.Tip="Ellipse"><Path Data="{StaticResource IconCircle}" /></Button>
                <Button Name="BtnToolArrow" Classes="tb" Click="OnAnnotToolArrow" ToolTip.Tip="Arrow"><Path Data="{StaticResource IconArrow}" /></Button>
                <Button Name="BtnToolDraw" Classes="tb" Click="OnAnnotToolFreehand" ToolTip.Tip="Freehand"><Path Data="{StaticResource IconDraw}" /></Button>
                <Button Name="BtnToolImage" Classes="tb" Click="OnAnnotToolImage" ToolTip.Tip="Insert Image"><Path Data="{StaticResource IconImage}" /></Button>
                <Border Classes="tb-sep" />

                <Button Name="BtnToolBlur" Classes="tb" Click="OnAnnotToolBlur" ToolTip.Tip="Blur Region"><Path Data="{StaticResource IconBlur}" /></Button>
                <Button Name="BtnToolRedact" Classes="tb" Click="OnAnnotToolRedact" ToolTip.Tip="Redact"><Path Data="{StaticResource IconRedact}" /></Button>
                <Button Name="BtnToolNote" Classes="tb" Click="OnAnnotToolStickyNote" ToolTip.Tip="Sticky Note"><Path Data="{StaticResource IconNote}" /></Button>
                <Border Classes="tb-sep" />

                <!-- Text formatting -->
                <TextBlock Classes="tb-label" Text="FORMAT" Name="FormatLabel" />
                <TextBox Name="TbFontSize" Text="14" Width="36" FontSize="11"
                         VerticalAlignment="Center" Padding="3,2"
                         ToolTip.Tip="Font Size"
                         LostFocus="OnFormatFontSizeChanged" />
                <Button Name="BtnBold" Classes="tb" Content="B" FontWeight="Bold"
                        Click="OnFormatBoldToggle" ToolTip.Tip="Bold" />
                <Button Name="BtnItalic" Classes="tb" Content="I" FontStyle="Italic"
                        Click="OnFormatItalicToggle" ToolTip.Tip="Italic" />
                <TextBox Name="TbFontColor" Text="#000000" Width="60" FontSize="11"
                         VerticalAlignment="Center" Padding="3,2"
                         ToolTip.Tip="Text Color (#hex)"
                         LostFocus="OnFormatColorChanged" />
                <Border Classes="tb-sep" />

                <!-- Stamps quick access -->
                <TextBlock Classes="tb-label" Text="STAMP" />
                <Button Classes="tb" Click="OnStampApproved" ToolTip.Tip="Approved"><Path Data="{StaticResource IconCheck}" Fill="Green" /></Button>
                <Button Classes="tb" Click="OnStampRejected" ToolTip.Tip="Rejected"><Path Data="{StaticResource IconCross}" Fill="Red" /></Button>
                <Button Classes="tb" Click="OnStampDraft" ToolTip.Tip="Draft"><Path Data="{StaticResource IconWarning}" Fill="Goldenrod" /></Button>
                <Button Classes="tb" Click="OnStampConfidential" ToolTip.Tip="Confidential"><Path Data="{StaticResource IconLock}" /></Button>
                <Border Classes="tb-sep" />

                <Button Classes="tb" Click="OnBurnAnnotations" ToolTip.Tip="Burn Annotations into PDF">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="{StaticResource IconBurn}" Fill="OrangeRed" />
                        <TextBlock Text="Burn" Foreground="OrangeRed" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Tab Strip -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="4,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="tb" Click="OnNewTabClick"
                        Margin="4,0,0,0" ToolTip.Tip="New Tab"><Path Data="{StaticResource IconAdd}" /></Button>
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding ActiveTab}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"
                                           FontSize="11" Padding="6,2" />
                                <Button Padding="3,1"
                                        Click="OnCloseSpecificTabClick"
                                        VerticalAlignment="Center"
                                        Background="Transparent" Opacity="0.5">
                                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Search Bar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="6,3"
                IsVisible="{Binding ActiveTab.IsSearchVisible, FallbackValue=False}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Find:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" />
                <TextBox Text="{Binding ActiveTab.SearchQuery}"
                         Width="260" VerticalAlignment="Center" FontSize="11" Padding="4,3"
                         KeyDown="OnSearchKeyDown" />
                <Button Classes="tb" Click="OnDoSearchClick" ToolTip.Tip="Find"><Path Data="{StaticResource IconSearch}" /></Button>
                <Button Classes="tb" Click="OnPrevSearchClick" ToolTip.Tip="Previous"><Path Data="{StaticResource IconChevronLeft}" /></Button>
                <Button Classes="tb" Click="OnNextSearchClick" ToolTip.Tip="Next"><Path Data="{StaticResource IconChevronRight}" /></Button>
                <Button Classes="tb" Click="OnCloseSearchClick" ToolTip.Tip="Close"><Path Data="{StaticResource IconClose}" Width="12" Height="12" /></Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area with GridSplitters for resizable panels -->
        <Grid ColumnDefinitions="200,Auto,*,Auto,250"
              IsVisible="{Binding HasActiveTab}">

            <!-- Left Panel: Page Thumbnails -->
            <Border Grid.Column="0" MinWidth="100"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Margin="2,0,0,6">
                        <TextBlock Text="Pages" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveTab.SelectionInfoText, FallbackValue=''}"
                                   FontSize="11" Opacity="0.6" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox Name="ThumbListBox"
                             ItemsSource="{Binding ActiveTab.Thumbnails}"
                             SelectedIndex="{Binding ActiveTab.SelectedThumbnailIndex}"
                             SelectionMode="Multiple"
                             SelectionChanged="OnThumbnailSelectionChanged"
                             PointerPressed="ThumbListBox_PointerPressed"
                             PointerMoved="ThumbListBox_PointerMoved"
                             PointerReleased="ThumbListBox_PointerReleased"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Select All" Click="OnSelectAllClick" />
                                <Separator />
                                <MenuItem Header="Delete Page(s)" Click="OnContextDeleteClick" />
                                <MenuItem Header="Rotate Right 90°" Click="OnContextRotateRightClick" />
                                <MenuItem Header="Rotate Left 90°" Click="OnContextRotateLeftClick" />
                                <Separator />
                                <MenuItem Header="Move Up" Click="OnContextMoveUpClick" />
                                <MenuItem Header="Move Down" Click="OnContextMoveDownClick" />
                                <Separator />
                                <MenuItem Header="Extract Selected Pages..." Click="OnExtractSelectedClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            BorderThickness="1" Padding="2"
                                            BoxShadow="0 1 3 0 #30000000">
                                        <Image Source="{Binding Image}"
                                               Width="140" Height="180"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                               HorizontalAlignment="Center"
                                               FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter: Left panel ↔ Center -->
            <GridSplitter Grid.Column="1" Width="5"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <!-- Center Panel: Document Viewer -->
            <Border Grid.Column="2">
                <Grid RowDefinitions="*,Auto">
                    <!-- PDF Page Display with annotation overlay -->
                    <ScrollViewer Grid.Row="0" Name="PageScrollViewer"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto">
                        <!-- Annotation canvas overlaid on the page image -->
                        <Panel HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="20">
                            <Border BoxShadow="0 2 10 0 #40000000"
                                    IsVisible="{Binding ActiveTab.IsDocumentLoaded, FallbackValue=False}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Extract Text from Page" Click="OnExtractTextViewClick" />
                                        <MenuItem Header="Export Page as Image..." Click="OnExportCurrentPageClick" />
                                        <Separator />
                                        <MenuItem Header="Zoom In" Click="OnContextZoomInClick" />
                                        <MenuItem Header="Zoom Out" Click="OnContextZoomOutClick" />
                                        <MenuItem Header="Zoom to Fit" Click="OnContextZoomFitClick" />
                                        <Separator />
                                        <MenuItem Header="Rotate Right 90°" Click="OnContextRotateRightClick" />
                                        <MenuItem Header="Rotate Left 90°" Click="OnContextRotateLeftClick" />
                                        <Separator />
                                        <MenuItem Header="Add Text Annotation" Click="OnAnnotToolText" />
                                        <MenuItem Header="Highlight" Click="OnAnnotToolHighlight" />
                                        <MenuItem Header="Blur Region" Click="OnAnnotToolBlur" />
                                        <Separator />
                                        <MenuItem Header="Print" Click="OnPrintClick" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel Name="PagePanel">
                                    <Image Name="PageImage"
                                           Source="{Binding ActiveTab.CurrentPageImage}"
                                           Stretch="None" />
                                    <!-- Annotation canvas overlaid on the PDF image -->
                                    <Canvas Name="AnnotationCanvas"
                                            PointerPressed="AnnotCanvas_PointerPressed"
                                            PointerMoved="AnnotCanvas_PointerMoved"
                                            PointerReleased="AnnotCanvas_PointerReleased"
                                            Background="Transparent"
                                            IsHitTestVisible="{Binding ActiveTab.IsAnnotationMode, FallbackValue=False}" />
                                </Panel>
                            </Border>
                        </Panel>
                    </ScrollViewer>

                    <!-- Placeholder when no document -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12"
                                IsVisible="{Binding ActiveTab.IsDocumentLoaded, FallbackValue=True, Converter={x:Static BoolConverters.Not}}">
                        <TextBlock Text="Open a PDF file to get started"
                                   FontSize="18" Opacity="0.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="File > Open  or  Ctrl+O"
                                   FontSize="14" Opacity="0.35"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Drop a PDF file here"
                                   FontSize="13" Opacity="0.25"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Search Results -->
                    <Border Grid.Row="0" VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch" MaxHeight="150"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding ActiveTab.IsSearchVisible, FallbackValue=False}">
                        <ListBox ItemsSource="{Binding ActiveTab.SearchResults}"
                                 MaxHeight="140"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 DoubleTapped="OnSearchResultDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Padding="4,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Navigation Bar -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button Click="OnFirstPageClick" Padding="8,4" ToolTip.Tip="First Page (Home)">
                                <Path Data="{StaticResource IconSkipPrev}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Button>
                            <Button Click="OnPrevPageClick" Padding="10,4" ToolTip.Tip="Previous Page">
                                <Path Data="{StaticResource IconChevronLeft}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Button>
                            <TextBlock Text="{Binding ActiveTab.PageInfoText, FallbackValue='No document'}"
                                       VerticalAlignment="Center" FontSize="13"
                                       FontWeight="SemiBold" MinWidth="120"
                                       TextAlignment="Center" />
                            <Button Click="OnNextPageClick" Padding="10,4" ToolTip.Tip="Next Page">
                                <Path Data="{StaticResource IconChevronRight}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Button>
                            <Button Click="OnLastPageClick" Padding="8,4" ToolTip.Tip="Last Page (End)">
                                <Path Data="{StaticResource IconSkipNext}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter: Center ↔ Right panel -->
            <GridSplitter Grid.Column="3" Width="5"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <!-- Right Panel: Properties & Tools -->
            <Border Grid.Column="4" MinWidth="120"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Margin="10,8">

                        <!-- Document Properties -->
                        <TextBlock Classes="rp-header" Text="Properties" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" FontSize="11" Opacity="0.6" Margin="0,0,6,3" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveTab.Title}" FontSize="11" Padding="4,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Author" FontSize="11" Opacity="0.6" Margin="0,3,6,3" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveTab.Author}" FontSize="11" Padding="4,2" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Subject" FontSize="11" Opacity="0.6" Margin="0,3,6,0" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveTab.Subject}" FontSize="11" Padding="4,2" Margin="0,3,0,0" />
                        </Grid>

                        <!-- File Info (compact) -->
                        <Border Background="{DynamicResource SystemControlHighlightListLowBrush}"
                                CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ActiveTab.FilePath, FallbackValue='No file'}"
                                           TextWrapping="Wrap" FontSize="10" Opacity="0.5" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock FontSize="11">
                                        <Run Text="Pages: " FontWeight="SemiBold" />
                                        <Run Text="{Binding ActiveTab.PageCount, FallbackValue='0'}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                                        <Run Text="Modified: " FontWeight="SemiBold" />
                                        <Run Text="{Binding ActiveTab.IsModified, FallbackValue='No'}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10" />

                        <!-- Quick Actions -->
                        <TextBlock Classes="rp-header" Text="Quick Actions" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Go to Page..." Click="OnGoToPageClick" />
                            <Button Classes="rp-btn" Content="Extract Text" Click="OnExtractTextViewClick" />
                            <Button Classes="rp-btn" Content="Export Images..." Click="OnExportImagesClick" />
                            <Button Classes="rp-btn" Content="Split Document..." Click="OnSplitClick" />
                            <Button Classes="rp-btn" Content="Crop Page..." Click="OnCropPageClick" />
                            <Button Classes="rp-btn" Content="Batch Processing..." Click="OnBatchProcessingClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Forms -->
                        <TextBlock Classes="rp-header" Text="Form Fields" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Detect Fields" Click="OnDetectFormFieldsClick" />
                            <Button Classes="rp-btn" Content="Fill Form..." Click="OnFillFormClick" />
                            <Button Classes="rp-btn" Content="Flatten Form" Click="OnFlattenFormClick" />
                            <Button Classes="rp-btn" Content="Export Form Data..." Click="OnExportFormDataClick" />
                            <Button Classes="rp-btn" Content="Import Form Data..." Click="OnImportFormDataClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Signatures -->
                        <TextBlock Classes="rp-header" Text="Signatures" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Sign Document..." Click="OnSignDocumentClick" />
                            <Button Classes="rp-btn" Content="Verify Signatures" Click="OnVerifySignaturesClick" />
                            <Button Classes="rp-btn" Content="List Signatures" Click="OnListSignaturesClick" />
                            <Button Classes="rp-btn" Content="Certificate Manager..." Click="OnCertificateManagerClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Annotations -->
                        <TextBlock Classes="rp-header" Text="Annotations" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Toggle Annotation Mode" Click="OnToggleAnnotationMode" />
                            <Button Classes="rp-btn" Content="Burn into PDF" Click="OnBurnAnnotations" Foreground="OrangeRed" />
                            <Button Classes="rp-btn" Content="Undo History..." Click="OnUndoHistoryClick" />
                            <Button Classes="rp-btn" Content="Annotation List..." Click="OnAnnotationListClick" />
                            <Button Classes="rp-btn" Content="Export Report..." Click="OnExportAnnotationReportClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Searchable PDF -->
                        <TextBlock Classes="rp-header" Text="Searchable PDF" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Make Searchable (OCR)..." Click="OnMakeSearchablePdfClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Redaction -->
                        <TextBlock Classes="rp-header" Text="Redaction" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Redact Text..." Click="OnRedactTextClick" />
                            <Button Classes="rp-btn" Content="Redact Current Page" Click="OnRedactPageClick" Foreground="OrangeRed" />
                            <Button Classes="rp-btn" Content="Find Targets..." Click="OnFindRedactionTargetsClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Document Comparison -->
                        <TextBlock Classes="rp-header" Text="Compare" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Compare Documents..." Click="OnCompareDocumentsClick" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <!-- Security -->
                        <TextBlock Classes="rp-header" Text="Security" />
                        <StackPanel Spacing="3">
                            <Button Classes="rp-btn" Content="Encrypt / Permissions..." Click="OnPermissionManagerClick" />
                            <Button Classes="rp-btn" Content="Decrypt Document..." Click="OnDecryptDocumentClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Welcome screen when no tabs -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding !HasActiveTab}">
            <TextBlock Text="PDF Editor" FontSize="36" FontWeight="Light"
                       HorizontalAlignment="Center" Opacity="0.5" />
            <TextBlock Text="Open a PDF to start editing"
                       FontSize="15" Opacity="0.35"
                       HorizontalAlignment="Center" />
            <Button Content="  Open PDF File  " Click="OnOpenClick"
                    Padding="16,8" FontSize="13"
                    HorizontalAlignment="Center" Margin="0,8,0,0" />
            <StackPanel Spacing="3" Margin="0,16,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Ctrl+O  Open   |   Ctrl+S  Save   |   Ctrl+P  Print   |   Ctrl+W  Close"
                           FontSize="11" Opacity="0.25" HorizontalAlignment="Center" />
                <TextBlock Text="Ctrl+F  Find   |   Ctrl+G  Go to Page   |   Ctrl+Z/Y  Undo/Redo"
                           FontSize="11" Opacity="0.25" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </DockPanel>

</Window>
