<Project>
  <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  SINGLE SOURCE OF TRUTH FOR APP VERSION                      ║
    ║  Change the Version here — it propagates to:                 ║
    ║    • All assemblies (Assembly/FileVersion)                    ║
    ║    • NuGet packages                                           ║
    ║    • The MSI installer (via build-installer.ps1)             ║
    ╚══════════════════════════════════════════════════════════════╝
  -->
  <PropertyGroup>
    <Version>0.0.3</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!--
      Allow C# 12 syntax (collection expressions, primary constructors, etc.) across
      all projects even though we target net6.0. The runtime is net6.0; the *language*
      version is independent and defaults to the SDK's supported maximum when set to
      'latest'.  Projects that already declare <LangVersion> will override this.
    -->
    <LangVersion>latest</LangVersion>

    <!-- Company / product metadata embedded in every assembly -->
    <Company>PDF-Editor</Company>
    <Product>PDF Editor</Product>
    <Copyright>Copyright © 2026 PDF-Editor</Copyright>
    <Authors>Oriol Canillas</Authors>
    <RepositoryUrl>https://github.com/OriolCanillasGautier/PDF-Editor</RepositoryUrl>
  </PropertyGroup>
</Project>
