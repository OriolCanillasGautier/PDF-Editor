<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="PDF Editor"
           Manufacturer="PDF-Editor"
           Version="$(var.AppVersion)"
           UpgradeCode="d85a2d64-8384-4a34-bc3a-d63799bb3b39"
           Language="1033">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <!--
      MajorUpgrade: detects any installed version with the same UpgradeCode.
      When installing a higher version it removes the old one first (no double-install).
      AllowSameVersionUpgrades lets you reinstall the same version (useful during dev).
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize" />
    <Media Id="1" Cabinet="PDFEditor.cab" EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />


    <Feature Id="Complete" Title="PDF Editor" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UninstallShortcut" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Product>

  <!-- ============ Directory layout ============ -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="PDF Editor" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="StartMenuDir" Name="PDF Editor" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- ============ Desktop shortcut ============ -->
  <Fragment>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="66D0068F-EA50-4E78-A2A2-27E18C612BDE">
        <Shortcut Id="DesktopShortcutFile"
                  Name="PDF Editor"
                  Description="Open PDF Editor"
                  Target="[INSTALLFOLDER]PDFEditor.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\PDFEditor"
                       Name="DesktopShortcut"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- ============ Start Menu shortcut ============ -->
  <Fragment>
    <DirectoryRef Id="StartMenuDir">
      <Component Id="StartMenuShortcut" Guid="2B56F759-5734-42C6-A962-04E6257A3830">
        <Shortcut Id="StartMenuShortcutFile"
                  Name="PDF Editor"
                  Description="Open PDF Editor"
                  Target="[INSTALLFOLDER]PDFEditor.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\PDFEditor"
                       Name="StartMenuShortcut"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- ============ Uninstall shortcut in Start Menu ============ -->
  <Fragment>
    <DirectoryRef Id="StartMenuDir">
      <Component Id="UninstallShortcut" Guid="A5CF1737-9B60-4EA0-9321-B86444734CC2">
        <Shortcut Id="UninstallShortcutFile"
                  Name="Uninstall PDF Editor"
                  Description="Remove PDF Editor from this computer"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU"
                       Key="Software\PDFEditor"
                       Name="UninstallShortcut"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

</Wix>
